# Server-side only. NEVER prefix with VITE_ (that would bundle it into browser code).
# Must be one of the keys listed in the backend's DOCU_MIND_API_KEYS.
# Copy this file to .env.local (git-ignored) and fill it in.
DOCUMIND_PROXY_API_KEY=

# Where the FastAPI backend runs.
DOCUMIND_BACKEND_URL=http://127.0.0.1:8001

# Production server (npm start) only.
PORT=5173
HOST=127.0.0.1
